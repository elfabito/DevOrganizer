# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# For SQLite (default):
DATABASE_URL=sqlite:///projects.db

# For Redis (optional - comment out REDIS_URL to use SQLite instead):
# Redis URL format: redis://[username]:[password]@[host]:[port]/[db]
# Local Redis (no password): redis://localhost:6379/0
# Redis with password: redis://:your-password@localhost:6379/0
# Redis Cloud/Remote: redis://:password@host:port/0
REDIS_URL=redis://localhost:6379/0

# AI Service Configuration (Groq)
GROQ_API_KEY=your-groq-api-key-here

# Session Configuration
# Note: When REDIS_URL is set, sessions will use Redis
# Otherwise, sessions will use filesystem storage
SESSION_FILE_DIR=.flask_session

# ClickUp Integration (optional)
# Users can configure their own tokens in the app settings
# CLICKUP_API_TOKEN=your-clickup-api-token-here

# Stripe Configuration (for subscriptions)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
# Get webhook secret from https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
# Create a product in Stripe Dashboard and copy the Price ID
STRIPE_PRICE_ID_PRO=price_your-price-id-here

# Application URL (for Stripe redirects and OAuth callbacks)
# Local development: http://127.0.0.1:5000
# Production: https://your-app-name.onrender.com
APP_URL=http://127.0.0.1:5000

# OAuth Configuration (for Social Login)
# Google OAuth - Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# GitHub OAuth - Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here
